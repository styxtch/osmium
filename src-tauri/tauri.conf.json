{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osmium",
  "version": "1.1.0",
  "identifier": "com.osmium.translator",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Osmium — Local AI Translator (Offline)",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 640,
        "maximized": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Osmium",
    "shortDescription": "Local Offline AI Translator for Text & Subtitles",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/*": "bin/"
    }
  }
}
